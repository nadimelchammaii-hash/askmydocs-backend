APP_NAME=AskMyDocs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use "localhost" (not 127.0.0.1) everywhere so Sanctum cookie auth works with the SPA.
APP_URL=http://localhost:8000
# The separate Vue SPA (askmydocs-frontend). Used for CORS, Sanctum and links in emails.
FRONTEND_URL=http://localhost:3000
# Hosts (with port) whose browser requests use cookie/session authentication (Sanctum SPA mode).
SANCTUM_STATEFUL_DOMAINS=localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + pgvector runs in the database-only container (docker-compose.db.yml).
# These values are also read by Docker Compose to create the database user on first start.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=askmydocs
DB_USERNAME=askmydocs
DB_PASSWORD=change-me
# Host port Docker publishes for the container's 5432. Keep equal to DB_PORT for native development.
DB_HOST_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds before a running job is considered lost and handed to another worker.
# Must exceed the longest job timeout (240 s for document embedding).
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Poppler binaries for PDF text extraction. Leave as-is when they are on PATH (Docker);
# on Windows use absolute paths with forward slashes (a backslash in double quotes is an escape),
# e.g. C:/tools/poppler-26.09.0/Library/bin/pdftotext.exe
PDFTOTEXT_BINARY=pdftotext
PDFINFO_BINARY=pdfinfo

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OpenAI (https://platform.openai.com/api-keys). Use a project key with a spending limit.
# Never commit a real key. Tests never call OpenAI.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector size in the document_chunks migration.
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT=30
# Answers (Responses API with Structured Outputs).
OPENAI_ANSWER_MODEL=gpt-6-luna
OPENAI_ANSWER_REASONING_EFFORT=low
OPENAI_ANSWER_MAX_OUTPUT_TOKENS=1000
OPENAI_ANSWER_TIMEOUT=60
