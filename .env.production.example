# Settings of the PRODUCTION stack (compose.prod.yaml). Copy to .env.production and fill in
# the secrets. .env.production is ignored by Git: never commit it.
#
# Values are read literally by Docker Compose: no quotes, no ${...} references.
# Generate secrets with:
#   APP_KEY      docker run --rm askmydocs-api:prod php artisan key:generate --show
#   DB_PASSWORD  any long random string (letters and digits only)

# --- Public address -----------------------------------------------------------------
# Domain Caddy serves and gets a certificate for. "localhost" = local test with a
# certificate from Caddy's own certificate authority (the browser shows a warning).
SITE_ADDRESS=localhost
# Interface the ports 80/443 listen on: 127.0.0.1 for a local test, 0.0.0.0 on a server.
WEB_BIND=127.0.0.1
# Strict-Transport-Security. Keep max-age=0 for localhost; on a real domain remove this
# line (default: one year) once HTTPS works.
HSTS=max-age=0

# --- Shared server (compose.shared.yaml only) ----------------------------------------
# Subnet of the Docker network shared with the other project's Caddy (default below).
# PROXY_SUBNET=10.250.250.0/24

# --- Server resources ---------------------------------------------------------------
# Defaults suit a small server shared with another project; raise on a bigger one.
# PHP_FPM_MAX_CHILDREN=4
# PG_SHARED_BUFFERS=64MB

# --- Application --------------------------------------------------------------------
APP_NAME=AskMyDocs
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The SPA and the API share one address (the API is under /api).
APP_URL=https://localhost
FRONTEND_URL=https://localhost
SANCTUM_STATEFUL_DOMAINS=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs go to the container output (`docker compose logs`).
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (also used by Compose to create the user on first start) -------------
DB_CONNECTION=pgsql
DB_DATABASE=askmydocs
DB_USERNAME=askmydocs
DB_PASSWORD=

# --- Sessions: HTTPS-only, encrypted cookies -----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300
CACHE_STORE=database

PDFTOTEXT_BINARY=pdftotext
PDFINFO_BINARY=pdfinfo

# --- Email (password reset) ---------------------------------------------------------
# Local test: Mailpit (inbox at http://localhost:8025). On a server, delete the
# COMPOSE_PROFILES line and use your provider's SMTP values: MAIL_HOST, MAIL_PORT,
# MAIL_SCHEME=smtp (STARTTLS), and the username/password.
# Ports: many cloud providers (DigitalOcean among them) block outgoing 25, 465 and 587;
# use the provider's alternative port then, e.g. Brevo: smtp-relay.brevo.com, port 2525.
# Test from the server first: nc -zv <MAIL_HOST> <port>
# Seconds to wait for the mail server (default 10):
# MAIL_TIMEOUT=10
COMPOSE_PROFILES=mailpit
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@askmydocs.test
MAIL_FROM_NAME=AskMyDocs

# --- OpenAI -------------------------------------------------------------------------
# Use a separate project key with a spending limit. Never commit a real key.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT=30
OPENAI_ANSWER_MODEL=gpt-6-luna
OPENAI_ANSWER_REASONING_EFFORT=low
OPENAI_ANSWER_MAX_OUTPUT_TOKENS=1000
OPENAI_ANSWER_TIMEOUT=60

RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.20
QUESTION_MAX_CHARS=1000
QUESTIONS_PER_MINUTE=10
QUESTIONS_PER_DAY=100
API_REQUESTS_PER_MINUTE=300

# "Try the demo" (config/demo.php). Samples: PDFs in DEMO_SOURCE_PATH, imported with
# `php artisan db:seed --class=DemoSeeder --force`. Defaults shown.
# DEMO_ENABLED=true
# DEMO_SOURCE_PATH=storage/app/demo-source
# DEMO_LIFETIME_HOURS=24
# DEMO_MAX_UPLOADS=1
# DEMO_QUESTIONS_PER_DAY=20
# DEMO_STARTS_PER_HOUR=3
# DEMO_STARTS_PER_DAY=200
